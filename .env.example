# Google Sheets: укажите реальные пути только в локальном файле .env.
GOOGLE_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=secrets/gcloud_key.json
# Необязательно: по умолчанию используется secrets/eat_session_state.json
EAT_SESSION_STATE_PATH=
# Не используется сборщиком API сайта через Playwright; оставлен только для
# возможной отдельной XML-интеграции ЕАТ.
EAT_API_TOKEN=
# Сборщик открывает публичный список и использует APIRequestContext той же сессии.
EAT_COLLECTION_BACKEND=browser
